{
	"name": "@draht/agent-core",
	"version": "2026.10.8",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./harness/context": {
			"types": "./dist/harness/context.d.ts",
			"import": "./dist/harness/context.js"
		},
		"./experimental/pico3": {
			"types": "./dist/harness/pico3/index.d.ts",
			"import": "./dist/harness/pico3/index.js"
		},
		"./harness/env/nodejs": {
			"types": "./dist/harness/env/nodejs.d.ts",
			"import": "./dist/harness/env/nodejs.js"
		},
		"./harness/runtime/reducer": {
			"types": "./dist/harness/runtime/reducer.d.ts",
			"import": "./dist/harness/runtime/reducer.js"
		},
		"./harness/session": {
			"types": "./dist/harness/session/index.d.ts",
			"import": "./dist/harness/session/index.js"
		},
		"./harness/session/testing": {
			"types": "./dist/harness/session/testing/index.d.ts",
			"import": "./dist/harness/session/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-telemetry-docs": "npx tsx scripts/generate-telemetry-docs.ts",
		"check:telemetry-docs": "npx tsx scripts/generate-telemetry-docs.ts --check",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"bench:session:timing": "vitest bench --config vitest.benchmark.config.ts",
		"bench:session:memory": "npx tsx --tsconfig benchmark/tsconfig.json benchmark/session/loaded-footprint.ts",
		"bench:session:allocations": "npx tsx --tsconfig benchmark/tsconfig.json benchmark/session/allocation-profile.ts",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"test:session:conformance": "vitest --run --config vitest.harness.config.ts test/harness/memory-conformance.test.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@draht/chord": "workspace:*",
		"@draht/ai": "workspace:*",
		"@draht/telemetry": "workspace:*",
		"diff": "^8.0.2",
		"ignore": "^7.0.8",
		"typebox": "^1.3.27",
		"yaml": "^2.9.0",
		"uuid": "^14.0.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Oskar Freye",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/draht-dev/draht.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@vitest/coverage-v8": "3.2.4",
		"typescript": "7.0.2",
		"vitest": "^3.2.4"
	}
}
