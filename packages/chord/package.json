{
	"name": "@draht/chord",
	"version": "2026.7.30",
	"description": "Application composition runtime for services, replicated state, RPC, and plugins",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./api": {
			"source": "./src/api.ts",
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		},
		"./context": {
			"source": "./src/context/index.ts",
			"types": "./dist/context/index.d.ts",
			"import": "./dist/context/index.js"
		},
		"./types": {
			"source": "./src/types.ts",
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"application",
		"plugins",
		"rpc",
		"services",
		"state"
	],
	"author": "Oskar Freye",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/draht-dev/draht.git",
		"directory": "packages/chord"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "^3.2.4"
	}
}
