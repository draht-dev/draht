{
	"name": "@draht/install",
	"version": "2026.7.30",
	"description": "Draht unified installer — transactional plan/install/status/doctor/update/uninstall for Draht components (Claude/Codex plugin payloads, coding agent, the installer itself) over hash-manifested state",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"draht-install": "./dist/cli.js",
		"draht-init": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@draht/tools": "workspace:*",
		"semver": "^7.8.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"@types/semver": "^7.7.1",
		"typescript": "7.0.2",
		"vitest": "^3.2.4"
	}
}
