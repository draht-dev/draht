{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "draht-install doctor --json",
  "description": "The single document `doctor --json` writes. Any finding with severity `error` makes the command exit 1.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "doctor"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "root": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "repairable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "severity",
          "message",
          "repairable"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "root",
    "findings"
  ],
  "additionalProperties": false
}
