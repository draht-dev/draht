    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "event": {
          "type": "string",
          "const": "scaffold-start"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
