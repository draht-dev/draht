          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "event",
        "transactions",
        "notes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
