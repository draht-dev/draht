                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude-plugin",
                      "codex-plugin",
                      "global-cli"
                    ]
                  },
                  "toVersion": {
                    "type": "string"
                  },
                  "fromVersion": {
                    "type": "string"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "npmName": {
                        "type": "string"
                      },
                      "resolvedVersion": {
                        "type": "string"
                      },
                      "integrity": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "npmName",
                      "resolvedVersion"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "componentId",
                  "kind",
                  "toVersion",
                  "fromVersion",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "remove"
                  },
                  "componentId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "claude-plugin",
                      "codex-plugin",
                      "global-cli"
                    ]
                  },
                  "fromVersion": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "componentId",
                  "kind",
                  "fromVersion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "delegate-install"
                  },
                  "componentId": {
                    "type": "string"
