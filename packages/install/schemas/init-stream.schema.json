        "version": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "event",
        "componentId",
        "type",
        "notes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "init"
        },
        "event": {
          "type": "string",
          "const": "blocked"
        },
        "componentId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
