{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "draht-init --json (NDJSON stream)",
  "description": "One JSON object per line: component-apply progress, then a `scaffold-start` per draht-tools invocation, then exactly one `summary` — or one error document if the command failed.",
