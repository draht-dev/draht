    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "event": {
          "type": "string",
          "const": "summary"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "project": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "const": "init"
        }
      },
      "required": [
        "schemaVersion",
        "event",
        "ok",
        "project",
        "handoff",
        "command"
      ],
      "additionalProperties": false
    },
    {
      "title": "draht-install --json error document",
      "description": "Emitted instead of a success document when a command fails. `error.code` is the machine-readable discriminator; `error.message` is prose that may change between releases and must not be parsed.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "command": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "ok",
        "command",
