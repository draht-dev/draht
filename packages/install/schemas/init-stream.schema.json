        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "init"
        },
        "event": {
          "type": "string",
          "const": "action-start"
        },
        "componentId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "install",
            "update",
            "remove",
            "delegate-install",
            "delegate-uninstall"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "event",
        "componentId",
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
