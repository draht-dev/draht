{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "draht-install status --json",
  "description": "The single document `status --json` writes. `pendingChanges` counts components whose drift is `drifted` or `missing`; with --check a non-zero count exits 2.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "type": "string",
      "const": "status"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "channel": {
      "type": "string",
      "const": "latest"
    },
    "root": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "claude-plugin",
              "codex-plugin",
              "global-cli"
            ]
          },
          "version": {
            "type": "string"
          },
          "effectiveness": {
            "type": "string",
            "enum": [
              "live",
              "after-reload",
              "next-session",
              "restart-required",
              "unknown"
            ]
          },
          "drift": {
            "type": "string",
            "enum": [
              "clean",
              "drifted",
              "missing",
              "delegated",
              "unknown"
            ]
          },
          "delegated": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "packageName": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "packageName"
            ],
            "additionalProperties": false
          },
          "targetDir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "effectiveness",
          "drift",
          "targetDir"
        ],
        "additionalProperties": false
      }
    },
    "pendingChanges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "channel",
    "root",
    "components",
    "pendingChanges"
  ],
  "additionalProperties": false
}
