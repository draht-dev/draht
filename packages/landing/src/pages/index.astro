			[
				{ t: "prompt", v: "› " }, { t: "user", v: "/execute-phase 1" },
				{ t: "nl" },
				{ t: "nl" },
				{ t: "dim", v: "  → " }, { t: "key", v: "implementer" }, { t: "dim", v: "  sonnet   feature/idempotency" },
				{ t: "nl" },
