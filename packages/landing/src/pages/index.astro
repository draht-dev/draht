		.hero h1 {
			font-family: var(--f-display);
			font-weight: 300;
			font-size: clamp(72px, 16vw, 240px);
			line-height: 0.88;
			letter-spacing: -0.035em;
			margin: 0 0 28px;
			color: var(--paper);
			font-style: italic;
		}
		.hero h1 .ampersand {
			font-style: italic;
			color: var(--copper);
			font-weight: 300;
		}

		.hero-subhead {
			font-family: var(--f-display);
			font-style: normal;
			font-weight: 400;
			font-size: clamp(22px, 2.6vw, 34px);
			line-height: 1.25;
			letter-spacing: -0.012em;
			color: var(--paper-dim);
			margin: 0 0 clamp(48px, 6vw, 80px);
			max-width: 22ch;
			text-wrap: balance;
		}
		.hero-subhead .hb {
			font-style: italic;
			color: var(--paper);
		}

		.hero-grid {
			display: grid;
			grid-template-columns: 1.1fr 1fr;
			gap: clamp(40px, 6vw, 96px);
			align-items: end;
		}

		.hero-lede {
			font-family: var(--f-display);
			font-size: clamp(20px, 2vw, 26px);
			font-weight: 400;
			line-height: 1.45;
			color: var(--paper);
			max-width: 34ch;
			text-wrap: pretty;
		}
		.hero-lede .drop {
			font-style: italic;
			color: var(--copper);
		}
		.hero-lede .wire {
			font-style: italic;
			color: var(--paper-soft);
		}

		.hero-cta {
			display: flex;
			flex-direction: column;
			gap: 28px;
			align-items: flex-start;
		}
		.hero-specs {
			display: grid;
			grid-template-columns: repeat(4, auto);
			gap: 0;
			margin: 0;
			padding: 0;
			border-top: 1px solid var(--rule);
			border-bottom: 1px solid var(--rule);
			width: 100%;
		}
		.hero-specs > div {
			display: flex;
			flex-direction: column;
			gap: 4px;
			padding: 14px 18px 14px 0;
			border-right: 1px dashed rgba(239, 231, 216, 0.10);
			min-width: 0;
		}
		.hero-specs > div:last-child {
			border-right: none;
			padding-right: 0;
		}
		.hero-specs dt {
			font-family: var(--f-mono);
			font-size: 9px;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--paper-soft);
		}
		.hero-specs dd {
			margin: 0;
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 400;
			font-size: 22px;
			line-height: 1;
			color: var(--paper);
			letter-spacing: -0.01em;
		}
		.hero-specs dd.zero {
			color: var(--copper);
		}
		.hero-install {
			margin-top: clamp(40px, 5vw, 72px);
			position: relative;
			z-index: 2;
		}
		.hero-install .install-col {
			padding: clamp(22px, 2.2vw, 32px);
		}
		.hero-install .install-badge {
			margin-bottom: 18px;
		}
		.hero-install .install-badge .ib-num {
			font-size: 40px;
		}
		.hero-install .install-badge .ib-title {
			font-size: 20px;
		}
		.hero-install .install-note {
			font-size: 13px;
			margin-top: 14px;
			max-width: 38ch;
		}
		.install {
			font-family: var(--f-mono);
			background: var(--ink-2);
			border: 1px solid var(--rule-strong);
			padding: 14px 18px;
			font-size: 13px;
			color: var(--paper);
			display: flex;
			gap: 12px;
			align-items: center;
			width: 100%;
			max-width: 460px;
			position: relative;
		}
		.install::before {
			content: "";
			position: absolute;
			left: -6px;
			top: 50%;
			transform: translateY(-50%);
			width: 12px;
			height: 12px;
			border-radius: 50%;
			background: var(--copper);
			box-shadow: 0 0 0 2px var(--ink), 0 0 12px color-mix(in oklab, var(--copper), transparent 40%);
		}
		.install .prompt {
			color: var(--copper);
			user-select: none;
		}
		.install code {
			flex: 1;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.install button {
			background: transparent;
			border: 1px solid var(--rule-strong);
			color: var(--paper-soft);
			font-family: var(--f-mono);
			font-size: 10px;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			padding: 5px 10px;
			cursor: pointer;
			transition: all 0.2s;
		}
		.install button:hover {
			color: var(--copper);
			border-color: var(--copper);
		}

		.cta-row {
			display: flex;
			gap: 18px;
			align-items: center;
			font-size: 13px;
		}
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			padding: 12px 22px;
			background: var(--paper);
			color: var(--ink);
			font-family: var(--f-ui);
			font-weight: 500;
			letter-spacing: 0.02em;
			border: 1px solid var(--paper);
			transition: all 0.2s;
		}
		.btn:hover {
			background: var(--copper);
			border-color: var(--copper);
			color: var(--ink);
		}
		.btn.ghost {
			background: transparent;
			color: var(--paper-soft);
			border-color: var(--rule-strong);
		}
		.btn.ghost:hover {
			color: var(--paper);
			border-color: var(--paper);
		}

		/* ---------- Schematic border + wire routing ---------- */
		.schematic {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 0;
		}
		.schematic svg { width: 100%; height: 100%; }

		/* ---------- Global wire layer (Schaltplan) ---------- */
		.wireplan {
			position: fixed;
			inset: 0;
			pointer-events: none;
			z-index: 1;
		}
		.wireplan svg {
			width: 100%;
			height: 100%;
			display: block;
		}

		.wire-trace {
			fill: none;
			stroke: var(--copper);
			stroke-width: 1.25;
			stroke-linecap: round;
			stroke-linejoin: round;
			opacity: 0.55;
			filter: drop-shadow(0 0 3px color-mix(in oklab, var(--copper), transparent 60%));
		}
		.wire-trace.faint {
			stroke: var(--copper-dim);
			opacity: 0.32;
			stroke-width: 1;
		}
		.wire-trace.bus {
			stroke-width: 1.5;
			opacity: 0.75;
		}
		.wire-trace.dashed {
			stroke: var(--paper-soft);
			stroke-dasharray: 2 5;
			opacity: 0.35;
			stroke-width: 1;
			filter: none;
		}

		.wire-pulse {
			fill: none;
			stroke: var(--copper);
			stroke-width: 2;
			stroke-linecap: round;
			filter: drop-shadow(0 0 6px var(--copper)) drop-shadow(0 0 14px var(--copper-dim));
			stroke-dasharray: 18 2000;
		}

		.wire-emission {
			fill: none;
			stroke: var(--copper);
			stroke-width: 2;
			stroke-linecap: round;
			stroke-dasharray: 4 200;
			filter: drop-shadow(0 0 5px var(--copper)) drop-shadow(0 0 12px var(--copper-dim));
		}

		.wire-node {
			fill: var(--ink);
			stroke: var(--copper);
			stroke-width: 1.25;
		}
		.wire-node.solid {
			fill: var(--copper);
			stroke: none;
		}
		.wire-node.pulse {
			animation: nodePulse 2.8s ease-in-out infinite;
			transform-origin: center;
			transform-box: fill-box;
		}
		@keyframes nodePulse {
			0%, 100% { opacity: 0.4; }
			50%      { opacity: 1; filter: drop-shadow(0 0 8px var(--copper)); }
		}

		.wire-label {
			fill: var(--paper-soft);
			font-family: var(--f-mono);
			font-size: 9px;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			opacity: 0.55;
		}
		.wire-label.accent {
			fill: var(--copper);
			opacity: 0.8;
		}

		.wire-draw {
			stroke-dasharray: var(--len, 1000);
			stroke-dashoffset: var(--len, 1000);
			transition: stroke-dashoffset 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
		}
		.revealed .wire-draw { stroke-dashoffset: 0; }

		@media (prefers-reduced-motion: reduce) {
			.wire-pulse, .wire-node.pulse, .wire-emission { animation: none !important; }
			.wire-draw { stroke-dashoffset: 0 !important; }
		}

		/* ---------- Section header ---------- */
		.section {
			position: relative;
			padding: clamp(80px, 10vw, 140px) 0;
			border-top: 1px solid var(--rule);
		}
		.section-head {
			display: grid;
			grid-template-columns: auto 1fr auto;
			gap: 32px;
			align-items: baseline;
			margin-bottom: 64px;
			padding-bottom: 18px;
			border-bottom: 1px solid var(--rule);
		}
		.section-num {
			font-family: var(--f-mono);
			font-size: 12px;
			color: var(--copper);
			letter-spacing: 0.1em;
		}
		.section-title {
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 300;
			font-size: clamp(32px, 4vw, 56px);
			line-height: 1;
			letter-spacing: -0.02em;
			color: var(--paper);
		}
		.section-title em {
			font-family: var(--f-display);
			font-style: normal;
			color: var(--paper-soft);
			font-size: 0.5em;
			letter-spacing: 0;
			margin-left: 14px;
			text-transform: lowercase;
		}
		.section-kicker {
			font-family: var(--f-mono);
			font-size: 11px;
			color: var(--paper-soft);
			letter-spacing: 0.15em;
			text-transform: uppercase;
			text-align: right;
		}

		/* ---------- How it works ---------- */
		.wires {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: clamp(20px, 3vw, 48px);
			position: relative;
		}
		.card .pin { opacity: 0; }
		.card {
			position: relative;
			padding-top: 64px;
		}
		.card .pin {
			position: absolute;
			top: 18px;
			left: 50%;
			transform: translateX(-50%);
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: var(--ink);
			border: 1px solid var(--rule-strong);
			display: grid;
			place-items: center;
			z-index: 1;
		}
		.card .pin::before {
			content: "";
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--copper);
			box-shadow: 0 0 12px color-mix(in oklab, var(--copper), transparent 20%);
		}
		.card h3 {
			font-family: var(--f-display);
			font-weight: 400;
			font-style: italic;
			font-size: 28px;
			letter-spacing: -0.01em;
			margin: 0 0 14px;
			color: var(--paper);
		}
		.card p {
			color: var(--paper-dim);
			font-size: 15px;
			line-height: 1.55;
			margin: 0;
			text-wrap: pretty;
		}
		.card .label {
			font-family: var(--f-mono);
			font-size: 10px;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--copper);
			margin-bottom: 8px;
		}

		/* ---------- Terminal + features side by side ---------- */
		.workbench {
			display: grid;
			grid-template-columns: 1.2fr 1fr;
			gap: clamp(32px, 5vw, 72px);
			align-items: start;
		}
		.terminal {
			background: var(--ink-2);
			border: 1px solid var(--rule-strong);
			font-family: var(--f-mono);
			font-size: 13px;
			line-height: 1.6;
			position: relative;
			overflow: hidden;
		}
		.terminal .tbar {
			display: flex;
			align-items: center;
			gap: 8px;
			padding: 10px 14px;
			border-bottom: 1px solid var(--rule);
			font-size: 10px;
			color: var(--paper-soft);
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}
		.terminal .tbar .tdots {
			display: flex;
			gap: 6px;
			margin-right: 12px;
		}
		.terminal .tbar .tdots i {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			display: inline-block;
			background: #3a332a;
		}
		.terminal .body {
			padding: 20px 22px;
			min-height: 320px;
		}
		.terminal .line { white-space: pre-wrap; }
		.t-prompt { color: var(--copper); }
		.t-user   { color: var(--paper); }
		.t-dim    { color: var(--paper-soft); }
		.t-ok     { color: var(--patina); }
		.t-key    { color: var(--copper); }
		.cursor {
			display: inline-block;
			width: 8px;
			height: 14px;
			background: var(--copper);
			vertical-align: middle;
			margin-left: 2px;
			animation: cursorBlink 1s step-end infinite;
		}
		@keyframes cursorBlink {
			50% { opacity: 0; }
		}

		.feat-list {
			display: grid;
			gap: 22px;
		}
		.feat {
			display: grid;
			grid-template-columns: 56px 1fr;
			gap: 18px;
			padding: 18px 0;
			border-bottom: 1px solid var(--rule);
		}
		.feat:last-child { border-bottom: none; }
		.feat .fnum {
			font-family: var(--f-mono);
			font-size: 11px;
			color: var(--paper-soft);
			letter-spacing: 0.1em;
			padding-top: 4px;
		}
		.feat h4 {
			font-family: var(--f-display);
			font-weight: 500;
			font-size: 20px;
			margin: 0 0 6px;
			color: var(--paper);
			letter-spacing: -0.01em;
		}
		.feat p {
			margin: 0;
			font-size: 14px;
			line-height: 1.5;
			color: var(--paper-dim);
		}
		.feat h4 em {
			font-style: italic;
			color: var(--copper);
			font-weight: 400;
		}

		/* ---------- Philosophy ---------- */
		.manifest {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 2px;
			background: var(--rule);
			border: 1px solid var(--rule);
		}
		.clause {
			background: var(--ink);
			padding: clamp(24px, 3vw, 40px);
			position: relative;
		}
		.clause .cnum {
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 300;
			font-size: 72px;
			line-height: 1;
			color: var(--copper);
			margin-bottom: 12px;
			letter-spacing: -0.04em;
		}
		.clause .neg {
			font-family: var(--f-mono);
			font-size: 11px;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--paper-soft);
			margin-bottom: 8px;
		}
		.clause h5 {
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 400;
			font-size: 28px;
			margin: 0 0 12px;
			color: var(--paper);
			letter-spacing: -0.01em;
		}
		.clause p {
			margin: 0;
			font-size: 14px;
			line-height: 1.6;
			color: var(--paper-dim);
			max-width: 42ch;
		}

		/* ---------- Install split ---------- */
		.install-split {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2px;
			background: var(--rule);
			border: 1px solid var(--rule);
		}
		.install-col {
			background: var(--ink);
			padding: clamp(28px, 3vw, 44px);
		}
		.install-badge {
			display: flex;
			gap: 16px;
			align-items: flex-start;
			margin-bottom: 24px;
		}
		.install-badge .ib-num {
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 300;
			font-size: 48px;
			line-height: 1;
			color: var(--copper);
			letter-spacing: -0.04em;
		}
		.install-badge .ib-title {
			font-family: var(--f-display);
			font-size: 22px;
			color: var(--paper);
			letter-spacing: -0.01em;
			margin-bottom: 4px;
		}
		.install-badge .ib-sub {
			font-family: var(--f-mono);
			font-size: 11px;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--paper-soft);
		}
		.install-note {
			margin: 18px 0 0;
			font-family: var(--f-display);
			font-size: 15px;
			line-height: 1.55;
			color: var(--paper-dim);
			max-width: 44ch;
		}

		/* ---------- Pricing ---------- */
		.pricing {
			display: grid;
			grid-template-columns: 1fr 1fr 1fr;
			gap: 2px;
			background: var(--rule);
			border: 1px solid var(--rule);
		}
		.tier {
			background: var(--ink);
			padding: clamp(28px, 3vw, 40px);
			display: flex;
			flex-direction: column;
			position: relative;
		}
		.tier.featured {
			background:
				linear-gradient(180deg, color-mix(in oklab, var(--copper), transparent 92%), transparent 70%),
				radial-gradient(140% 90% at 50% 0%, color-mix(in oklab, var(--copper), transparent 95%), transparent 60%);
		}
		.tier.featured::before {
			content: "Empfohlen";
			position: absolute;
			top: 16px;
			right: 16px;
			font-family: var(--f-mono);
			font-size: 10px;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--copper);
			padding: 4px 8px;
			border: 1px solid var(--copper);
		}
		.tier-num {
			font-family: var(--f-mono);
			font-size: 11px;
			letter-spacing: 0.15em;
			color: var(--paper-soft);
			margin-bottom: 12px;
		}
		.tier-name {
			font-family: var(--f-display);
			font-style: italic;
			font-weight: 400;
			font-size: 36px;
			color: var(--paper);
			letter-spacing: -0.02em;
			margin-bottom: 6px;
		}
		.tier-tag {
			font-family: var(--f-mono);
			font-size: 11px;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--paper-soft);
			margin-bottom: 24px;
		}
		.tier-price {
			font-family: var(--f-display);
			font-size: 56px;
			font-weight: 300;
			color: var(--copper);
			letter-spacing: -0.04em;
			line-height: 1;
			margin-bottom: 4px;
		}
		.tier-price em {
			font-size: 16px;
			font-style: italic;
			color: var(--paper-soft);
			margin-left: 8px;
			letter-spacing: 0;
		}
		.tier-unit {
			font-family: var(--f-mono);
			font-size: 10px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--paper-soft);
			margin-bottom: 28px;
			padding-bottom: 28px;
			border-bottom: 1px solid var(--rule);
		}
		.tier ul {
			list-style: none;
			margin: 0 0 32px;
			padding: 0;
			font-family: var(--f-display);
			font-size: 15px;
			line-height: 1.5;
			color: var(--paper-dim);
			flex: 1;
		}
		.tier ul li {
			padding: 8px 0 8px 20px;
			position: relative;
			border-bottom: 1px dashed rgba(239, 231, 216, 0.08);
		}
		.tier ul li:last-child { border-bottom: none; }
		.tier ul li::before {
			content: "—";
			position: absolute;
			left: 0;
			color: var(--copper);
		}
		.tier ul li em {
			font-style: italic;
			color: var(--paper-soft);
		}
		.tier-cta {
			display: inline-flex;
			align-items: center;
			gap: 12px;
			padding: 14px 20px;
			border: 1px solid var(--rule-strong);
			color: var(--paper);
			font-family: var(--f-mono);
			font-size: 11px;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			text-decoration: none;
			transition: all 0.2s;
			align-self: flex-start;
		}
		.tier-cta:hover {
			border-color: var(--copper);
			color: var(--copper);
		}
		.tier.featured .tier-cta {
			background: var(--copper);
			color: var(--ink);
			border-color: var(--copper);
		}
		.tier.featured .tier-cta:hover {
			background: transparent;
			color: var(--copper);
		}

		/* ---------- Packages ---------- */
		.pkg-list {
			display: grid;
			gap: 0;
			border-top: 1px solid var(--rule);
		}
		.pkg {
			display: grid;
			grid-template-columns: 60px 1.5fr 2fr 100px;
			gap: 24px;
			align-items: baseline;
			padding: 24px 4px;
			border-bottom: 1px solid var(--rule);
			transition: background 0.25s;
			position: relative;
		}
		.pkg:hover { background: rgba(239, 231, 216, 0.02); }
		.pkg:hover .pkg-name { color: var(--copper); }
		.pkg-idx {
			font-family: var(--f-mono);
			font-size: 11px;
