			padding: 0 var(--gutter);
		}

		/* ---------- Topbar ---------- */

		/* ---------- Hero ---------- */
		.hero {
			position: relative;
			padding: clamp(64px, 10vw, 140px) 0 clamp(80px, 12vw, 180px);
		}

		.tag {
			display: inline-flex;
