---
import Atelier from "../layouts/Atelier.astro";
import Navbar from "../components/Navbar.astro";

const title = "draht - coding agents that ship for less";
const description = "Draht routes each coding task to the cheapest model that can do it. It writes tests first, checks the domain, and logs every call. Use it in Claude Code or run the CLI.";
---

<Atelier title={title} description={description}>
	<!-- ================= GLOBAL WIRE LAYER ================= -->
	<div class="wireplan" id="wireplan" aria-hidden="true">
		<svg id="wire-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
			<defs>
				<radialGradient id="glowDot" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="var(--copper)" stop-opacity="1" />
					<stop offset="40%" stop-color="var(--copper)" stop-opacity="0.6" />
					<stop offset="100%" stop-color="var(--copper)" stop-opacity="0" />
				</radialGradient>
			</defs>
		</svg>
	</div>

	<div class="wrap">
		<!-- ===================== TOP ===================== -->
		<Navbar />

		<!-- ===================== HERO ===================== -->
		<section class="hero">
			<div class="schematic" aria-hidden="true">
				<svg viewBox="0 0 1240 720" preserveAspectRatio="none">
					<defs>
						<pattern id="dots" width="28" height="28" patternUnits="userSpaceOnUse">
							<circle cx="1" cy="1" r="0.6" fill="rgba(239,231,216,0.06)" />
						</pattern>
					</defs>
					<rect width="1240" height="720" fill="url(#dots)" />
				</svg>
			</div>

			<div class="tag">Dynamic routing for coding agents — handgefertigt in Dortmund</div>

			<h1>draht<span class="ampersand">.</span></h1>

			<p class="hero-subhead">
				Use the right model. Test before code.
				Read the <span class="hb">domain</span>.
				Orchestrate when it saves time.
			</p>

			<div class="hero-grid">
				<div class="hero-lede">
					<span class="drop">Draht</span> is German for <em class="wire">wire</em>. It routes coding-agent work. It picks the cheapest model for each step. It writes tests before code. It reads your domain model. It logs each call for audit or billing.
				</div>

				<div class="hero-cta">
					<div class="cta-row">
						<a class="btn" href="#packages">Browse packages &nbsp;→</a>
						<a class="btn ghost" href="https://github.com/draht-dev/draht">Read the source</a>
					</div>
					<dl class="hero-specs">
						<div><dt>License</dt><dd>MIT</dd></div>
						<div><dt>Packages</dt><dd>15</dd></div>
						<div><dt>Providers</dt><dd>17</dd></div>
						<div><dt>Telemetry</dt><dd class="zero">0</dd></div>
					</dl>
				</div>
			</div>

			<div class="install-split hero-install" id="hero-install">
				<div class="install-col">
					<div class="install-badge">
						<span class="ib-num">A.</span>
						<div>
							<div class="ib-title">Claude Code plugin</div>
							<div class="ib-sub">You have Claude Max or Pro. Keep it.</div>
						</div>
					</div>
					<div class="install" style="max-width:none;">
						<span class="prompt">$</span>
						<code>npx draht-claude install</code>
						<button type="button" class="copy-btn" data-copy="npx draht-claude install">Copy</button>
					</div>
					<p class="install-note">Add routing, TDD, orchestration, and audit logs to Claude Code.</p>
				</div>

				<div class="install-col">
					<div class="install-badge">
						<span class="ib-num">B.</span>
						<div>
							<div class="ib-title">Standalone CLI</div>
							<div class="ib-sub">Use API keys, OAuth, or your own models.</div>
						</div>
					</div>
					<div class="install" style="max-width:none;">
						<span class="prompt">$</span>
						<code>bun add -g @draht/coding-agent</code>
						<button type="button" class="copy-btn" data-copy="bun add -g @draht/coding-agent">Copy</button>
					</div>
					<p class="install-note">Run the full agent across 17 providers. Claude is not required.</p>
				</div>
			</div>
		</section>

		<!-- ===================== WIE ES FUNKTIONIERT ===================== -->
		<section class="section" id="werkstatt">
			<div class="section-head">
				<div class="section-num">§ 01</div>
				<div class="section-title">Wie es funktioniert <em>— how it works</em></div>
				<div class="section-kicker">Three wires. One circuit.</div>
			</div>

			<div class="wires">
				<div class="card">
					<div class="pin"></div>
					<div class="label">I. Route</div>
					<h3>Use the right model.</h3>
					<p>The router scores each task by reasoning, context, and latency. It sends simple work to cheap models. It saves Opus for hard architecture. You stop paying Opus rates for boilerplate.</p>
				</div>
				<div class="card">
					<div class="pin"></div>
					<div class="label">II. Test</div>
					<h3>Test first. Use the domain.</h3>
					<p>The agent writes a failing test before code. It reads bounded contexts, aggregates, and your team names. It edits in that language. Red tests block commits.</p>
				</div>
				<div class="card">
					<div class="pin"></div>
					<div class="label">III. Ship</div>
					<h3>Run, watch, prove.</h3>
					<p>The orchestrator runs independent work in parallel. CI blocks broken merges. The log records every model call, cost, and source. Use it for GDPR audits or invoice review.</p>
				</div>
			</div>
		</section>

		<!-- ===================== WORKBENCH ===================== -->
		<section class="section">
			<div class="section-head">
				<div class="section-num">§ 02</div>
				<div class="section-title">Die Werkbank <em>— the workbench</em></div>
				<div class="section-kicker">17 providers · 1 router · no lock-in</div>
			</div>

			<div class="workbench">
				<div class="terminal" aria-label="terminal demo">
					<div class="tbar">
						<span class="tdots"><i></i><i></i><i></i></span>
						<span>~/projects/atelier · draht</span>
					</div>
					<div class="body" id="term-body"></div>
				</div>

				<div class="feat-list">
					<div class="feat">
						<div class="fnum">F/01</div>
						<div>
							<h4>Routing you can <em>read.</em></h4>
							<p>Policies are TypeScript. Match file glob, task type, context size, or budget. Route to Haiku, Sonnet, Opus, GPT, Gemini, or your own model. Override per repo, branch, or session.</p>
						</div>
					</div>
					<div class="feat">
						<div class="fnum">F/02</div>
						<div>
							<h4>Sessions that <em>branch.</em></h4>
							<p>Every run writes a tree to one JSONL file. Jump back. Fork a branch. Swap the routing profile. Return later. Token costs stay on disk.</p>
						</div>
					</div>
					<div class="feat">
						<div class="fnum">F/03</div>
						<div>
							<h4>Sub-agents that <em>finish.</em></h4>
							<p>Seven specialists handle architecture, code, review, debug, verify, security, and git. You set the model for each one. Split work runs in parallel. Ordered work stays ordered. Commits use red:/green:/refactor: discipline.</p>
						</div>
					</div>
					<div class="feat">
						<div class="fnum">F/04</div>
						<div>
							<h4>Four ways to <em>run.</em></h4>
							<p>Use the REPL, print mode, JSON events, or RPC over stdin/stdout. Run draht in CI, a cron job, or a Slack bot. Embed the SDK in your app.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== PACKAGES ===================== -->
		<section class="section" id="packages">
			<div class="section-head">
				<div class="section-num">§ 03</div>
				<div class="section-title">Das Sortiment <em>— fifteen packages, one mono-repo</em></div>
				<div class="section-kicker">MIT licensed · pnpm workspace</div>
			</div>

			<div class="pkg-list">
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 01</span>
					<div class="pkg-name">@draht/router <em>the dispatcher</em></div>
					<div class="pkg-desc">Scores tasks and routes them to the cheapest model that can do the work. One policy covers Haiku, Sonnet, Opus, GPT, Gemini, and 12 more providers.</div>
					<div class="pkg-tag">CORE</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 02</span>
					<div class="pkg-name">@draht/orchestrator <em>the conductor</em></div>
					<div class="pkg-desc">Runs sub-agents in parallel for split work. Merges output, resolves conflicts, and returns one diff.</div>
					<div class="pkg-tag">CORE</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 03</span>
					<div class="pkg-name">@draht/knowledge <em>the domain</em></div>
					<div class="pkg-desc">Keeps a DDD map of your codebase: contexts, aggregates, and team words. The agent reads it before it writes.</div>
					<div class="pkg-tag">CORE</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 04</span>
					<div class="pkg-name">@draht/tdd <em>the red bar</em></div>
					<div class="pkg-desc">Enforces red-green-refactor. Code cannot commit until a failing test exists. Works with vitest, bun test, jest, and pytest.</div>
					<div class="pkg-tag">CORE</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 05</span>
					<div class="pkg-name">@draht/ci <em>the gate</em></div>
					<div class="pkg-desc">Runs agent changes through your real pipeline before they land. Fails loud. Retries narrow. Never waves work through.</div>
					<div class="pkg-tag">OPS</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 06</span>
					<div class="pkg-name">@draht/deploy-guardian <em>the sentinel</em></div>
					<div class="pkg-desc">Handles canary rollout, SLO checks, and rollback. The agent can ship to prod. The guardian can pull the cord.</div>
					<div class="pkg-tag">OPS</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 07</span>
					<div class="pkg-name">@draht/invoice <em>the ledger</em></div>
					<div class="pkg-desc">Tracks cost by task and model. Exports invoices with token counts, time logs, and VAT fields.</div>
					<div class="pkg-tag">BIZ</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 08</span>
					<div class="pkg-name">@draht/compliance <em>the notary</em></div>
					<div class="pkg-desc">Logs for GDPR, routes by data region, and signs each model-call record. Ready when a client asks.</div>
					<div class="pkg-tag">BIZ</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 09</span>
					<div class="pkg-name">@draht/templates <em>the patterns</em></div>
					<div class="pkg-desc">Ships starters for SaaS, API, CLI, and freelance repos. Each includes router policy, tests, and domain scaffold.</div>
					<div class="pkg-tag">LIBRARY</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 10</span>
					<div class="pkg-name">draht-claude <em>the bridge</em></div>
					<div class="pkg-desc">Installs draht in Claude Code. Keep your subscription. Add routing, TDD, and orchestration with no config.</div>
					<div class="pkg-tag">PLUGIN</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 11</span>
					<div class="pkg-name">@draht/cli <em>the standalone</em></div>
					<div class="pkg-desc">Runs the full agent in your terminal. Use API keys or OAuth. Claude Code is not required.</div>
					<div class="pkg-tag">CLI</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 12</span>
					<div class="pkg-name">@draht/ai <em>the primitives</em></div>
					<div class="pkg-desc">Unifies OpenAI, Anthropic, Google, and 14 other providers. Streams text, tools, thinking levels, and cache control.</div>
					<div class="pkg-tag">LIBRARY</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 13</span>
					<div class="pkg-name">@draht/extensions <em>the slots</em></div>
					<div class="pkg-desc">Hosts skills, prompt packs, custom tools, and UI panels. Each extension is a TypeScript module.</div>
					<div class="pkg-tag">LIBRARY</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 14</span>
					<div class="pkg-name">@draht/tui <em>the loom</em></div>
					<div class="pkg-desc">Renders the terminal UI with diff-based updates. The standalone CLI uses it.</div>
					<div class="pkg-tag">LIBRARY</div>
				</a>
				<a class="pkg" href="https://github.com/draht-dev/draht">
					<span class="pkg-idx">№ 15</span>
					<div class="pkg-name">@draht/pods <em>the foundry</em></div>
					<div class="pkg-desc">Manages vLLM deployments on GPU pods. Start, rotate, and retire self-hosted models from the command line.</div>
					<div class="pkg-tag">OPS</div>
				</a>
			</div>
		</section>

		<!-- ===================== PHILOSOPHY ===================== -->
		<section class="section" id="philosophie">
			<div class="section-head">
				<div class="section-num">§ 04</div>
				<div class="section-title">Philosophie <em>— six principles, non-negotiable</em></div>
				<div class="section-kicker">How draht decides for you.</div>
			</div>

			<div class="manifest">
				<div class="clause">
					<div class="cnum">i.</div>
					<div class="neg">— Cheapest model that works —</div>
					<h5>Route, don't default.</h5>
					<p>No model fits every task. The router scores the work and picks the cheapest model that can do it. You pay for Opus when the job needs Opus.</p>
				</div>
				<div class="clause">
					<div class="cnum">ii.</div>
					<div class="neg">— Red before green —</div>
					<h5>Test first, always.</h5>
					<p>The failing test is the spec. The agent must create a test, watch it fail, and make it pass before it commits code. If you skip TDD, skip draht.</p>
				</div>
				<div class="clause">
					<div class="cnum">iii.</div>
					<div class="neg">— Language of the domain —</div>
					<h5>DDD is not optional.</h5>
					<p>Bounded contexts, aggregates, and your team's words guide edits. The agent reads that model first. Guessing costs money.</p>
				</div>
				<div class="clause">
					<div class="cnum">iv.</div>
					<div class="neg">— Parallel by default —</div>
					<h5>Split work. Don't queue it.</h5>
					<p>Run independent work in parallel sub-agents. The orchestrator merges the output. One long task becomes three short tasks.</p>
				</div>
				<div class="clause">
					<div class="cnum">v.</div>
					<div class="neg">— Receipts for everything —</div>
					<h5>Audit is a feature.</h5>
					<p>Log every model call, cost, and billable step. The receipt sits on disk for clients, auditors, tax, or your own memory.</p>
				</div>
				<div class="clause">
					<div class="cnum">vi.</div>
					<div class="neg">— Boring ships —</div>
					<h5>No hidden magic.</h5>
					<p>Policies are files. State lives on disk. The harness is TypeScript. You can read it in an afternoon. If something surprises you, open the file.</p>
				</div>
			</div>
		</section>

		<!-- ===================== PRICING ===================== -->
		<section class="section" id="pricing">
			<div class="section-head">
				<div class="section-num">§ 05</div>
				<div class="section-title">Preise <em>— two ways to pay, one way to use</em></div>
				<div class="section-kicker">Open source forever · paid setup if needed</div>
			</div>

			<div class="pricing">
				<div class="tier">
					<div class="tier-num">Tier I</div>
					<div class="tier-name">Open Source</div>
					<div class="tier-tag">MIT · self-serve</div>
					<div class="tier-price">€0<em>forever</em></div>
					<div class="tier-unit">No account · no telemetry</div>
					<ul>
						<li>All 15 packages, full source</li>
						<li>Router, orchestrator, TDD, DDD</li>
						<li>Claude Code plugin &amp; standalone CLI</li>
						<li>Community Discord, GitHub issues</li>
						<li><em>Bring your own API keys</em></li>
					</ul>
					<a class="tier-cta" href="https://github.com/draht-dev/draht">Clone the repo →</a>
				</div>

				<div class="tier featured">
					<div class="tier-num">Tier II</div>
					<div class="tier-name">Freelance Setup</div>
					<div class="tier-tag">One-time · per project</div>
					<div class="tier-price">€499<em>one-time</em></div>
					<div class="tier-unit">incl. 19% VAT · remote, in writing</div>
					<ul>
						<li>2-hour call with your codebase on screen</li>
						<li>Tune router policy to <em>your</em> workload</li>
						<li>Bootstrap the domain model from your code</li>
						<li>Configure invoicing &amp; compliance for DE/EU</li>
						<li>30 days of Signal support</li>
					</ul>
					<a class="tier-cta" href="mailto:oskar@draht.dev">Book Oskar →</a>
				</div>

				<div class="tier">
					<div class="tier-num">Tier III</div>
					<div class="tier-name">Team &amp; Audit</div>
					<div class="tier-tag">Custom · on request</div>
					<div class="tier-price">—<em>let's talk</em></div>
					<div class="tier-unit">Typical engagement 4–12 weeks</div>
					<ul>
						<li>On-prem / air-gapped deployment</li>
						<li>Custom router policies &amp; extensions</li>
						<li>Compliance review: GDPR, AI Act, ISO</li>
						<li>Train the whole team</li>
						<li>Dedicated Signal channel</li>
					</ul>
					<a class="tier-cta" href="mailto:oskar@draht.dev?subject=Draht%20team%20engagement">Write Oskar →</a>
				</div>
			</div>
		</section>

