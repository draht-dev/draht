---
import AtelierPage from "../layouts/AtelierPage.astro";

const title = "draht uni — building in public";
const description =
	"uni.draht.dev is being built in public, one episode a week. Episode 1: the first brick is live now — join the waitlist for every episode.";
---

<AtelierPage title={title} description={description}>
	<main class="uni-main">
		<header class="page-head">
			<div class="page-kicker">uni.draht.dev · building in public</div>
			<h1 class="page-title">The university's first course is its own build<span class="ampersand">.</span></h1>
			<p class="page-lede">
				uni.draht.dev is being built in public, one episode a week. Episode 1: the first brick. Watch it happen — or get every episode in your inbox.
			</p>
		</header>

		<section class="waitlist">
			<!--
				TODO-CONFIGURE: point this form at the real ESP-hosted endpoint before launch.
				- List name (provider-side, domain-neutral per Gate 4.3 of the brainstorm doc): "draht uni waitlist"
				- Shape below assumes Buttondown's embed-subscribe endpoint
				  (https://buttondown.com/api/emails/embed-subscribe/<USERNAME>) — swap
				  "draht-uni" for the real Buttondown username, or repoint `action` at another
				  hosted ESP form endpoint (Loops, etc.). No custom backend/Lambda.
				- MUST enable double opt-in on the list before launch (DACH/DSGVO — Gate 3 + 4.3).
			-->
			<form
				class="waitlist-form"
				action="https://buttondown.com/api/emails/embed-subscribe/draht-uni"
				method="post"
				target="popupwindow"
				onsubmit="window.open('https://buttondown.com/draht-uni', 'popupwindow')"
			>
				<input
					type="email"
					name="email"
					placeholder="you@company.com"
					aria-label="Email address"
					required
				/>
				<input type="hidden" name="embed" value="1" />
				<button type="submit" class="btn">Join the waitlist — Episode 1 is live.</button>
			</form>
			<p class="waitlist-foot">The waitlist moves with the uni — uni.draht.dev takes over soon.</p>
		</section>

		<section class="episode">
			<div class="episode-kicker">Episode 01 · Live now</div>
			<h2 class="episode-title">the first brick</h2>
			<p class="episode-desc">
				The build starts at zero. Episode 1 lays the first brick — watch it, then get the next one in your inbox.
			</p>
			<!-- Points at the @freyedev X profile until we have the exact Episode 1 post/video permalink;
			     swap for a direct embed once the writeup lands in src/content/blog with category: "episode". -->
			<a href="https://x.com/freyedev" class="episode-link">Watch Episode 1 →</a>
		</section>
	</main>
</AtelierPage>

<style>
	.uni-main {
		max-width: 720px;
		margin: 0 auto;
	}

	.waitlist {
		padding: clamp(32px, 5vw, 48px) 0;
		border-bottom: 1px solid var(--rule);
	}

	.waitlist-form {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.waitlist-form input[type="email"] {
		flex: 1 1 260px;
		background: transparent;
		border: 1px solid var(--rule-strong);
		color: var(--paper);
		font-family: var(--f-ui);
		font-size: 15px;
		padding: 12px 16px;
	}
	.waitlist-form input[type="email"]::placeholder {
		color: var(--paper-soft);
	}
	.waitlist-form input[type="email"]:focus-visible {
		border-color: var(--copper);
	}

	.waitlist-foot {
		margin: 18px 0 0;
		font-family: var(--f-mono);
		font-size: 11px;
		letter-spacing: 0.05em;
		color: var(--paper-soft);
	}

	.episode {
		padding: clamp(32px, 5vw, 48px) 0;
	}

	.episode-kicker {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--f-mono);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--copper);
		margin-bottom: 16px;
	}

	.episode-title {
		font-family: var(--f-display);
		font-style: italic;
		font-weight: 300;
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--paper);
		margin: 0 0 14px;
	}

	.episode-desc {
		color: var(--paper-dim);
		font-size: 15px;
		line-height: 1.6;
		max-width: 56ch;
		margin: 0 0 20px;
		text-wrap: pretty;
	}

	.episode-link {
		font-family: var(--f-mono);
		font-size: 12px;
		letter-spacing: 0.05em;
		color: var(--copper);
	}
	.episode-link:hover {
		color: var(--paper);
	}
</style>
