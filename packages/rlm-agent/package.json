{
	"name": "@draht/rlm-agent",
	"version": "2026.7.13-1",
	"private": true,
	"description": "Coding-agent extension surface for @draht/rlm: /rlm slash command + rlm_query tool",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./extension": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"build": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@draht/rlm": "workspace:*",
		"@draht/router": "workspace:*",
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"@draht/ai": "workspace:*",
		"@draht/coding-agent": "workspace:*",
		"@types/node": "^22.10.5",
		"typescript": "7.0.2",
		"vitest": "^3.2.4"
	}
}
