{
	"name": "@draht/tui",
	"version": "2026.10.8-1",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "bun test test/*.test.ts",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"files": [
		"dist/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Oskar Freye",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/draht-dev/draht.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@types/mime-types": "^2.1.4",
		"chalk": "^5.5.0",
		"get-east-asian-width": "^1.6.0",
		"marked": "^15.0.12",
		"mime-types": "^3.0.1"
	},
	"optionalDependencies": {
		"koffi": "^2.9.0"
	},
	"devDependencies": {
		"@xterm/headless": "^5.5.0",
		"@xterm/xterm": "^5.5.0"
	}
}
