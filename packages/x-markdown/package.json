{
	"name": "@draht/x-markdown",
	"version": "2026.7.30",
	"private": true,
	"description": "Cloudflare Worker and draht extension for converting X posts into agent-readable Markdown",
	"type": "module",
	"bin": {
		"x-markdown": "./src/cli.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./extension": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		},
		"./worker": {
			"types": "./src/worker.ts",
			"import": "./src/worker.ts"
		}
	},
	"scripts": {
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.3.0",
		"typebox": "^1.3.7"
	},
	"devDependencies": {
		"@draht/coding-agent": "workspace:*",
		"typescript": "7.0.2"
	}
}
