{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@draht/chord": ["./packages/chord/src/index.ts"],
			"@draht/chord/context": ["./packages/chord/src/context/index.ts"],
			"@draht/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@draht/chord/node": ["./packages/chord/src/node.ts"],
			"@draht/chord/output": ["./packages/chord/src/output.ts"],
			"@draht/chord/sqlite": ["./packages/chord/src/sqlite/index.ts"],
			"@draht/chord/sqlite/node": ["./packages/chord/src/sqlite/node.ts"],
			"@draht/chord/sqlite/cloudflare": ["./packages/chord/src/sqlite/cloudflare.ts"],
			"@draht/telemetry": ["./packages/telemetry/src/index.ts"],
			"@draht/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@draht/codemode": ["./packages/codemode/src/index.ts"],
			"@draht/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@draht/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@draht/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@draht/codemode/source": ["./packages/codemode/src/source.ts"],
			"@draht/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@draht/mcp": ["./packages/mcp/src/index.ts"],
			"@draht/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@draht/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@draht/ai": ["./packages/ai/src/index.ts"],
			"@draht/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@draht/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@draht/ai/dist/*": ["./packages/ai/src/*"],
			"@draht/agent-core": ["./packages/agent/src/index.ts"],
			"@draht/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@draht/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@draht/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox"],
			"typebox": ["./node_modules/typebox"],
			"@draht/mom": ["./packages/mom/src/index.ts"],
			"@draht/mom/*": ["./packages/mom/src/*"],
			"@draht/pods": ["./packages/pods/src/index.ts"],
			"@draht/pods/*": ["./packages/pods/src/*"],
			"@draht/tui": ["./packages/tui/src/index.ts"],
			"@draht/tui/*": ["./packages/tui/src/*"],
			"@draht/web-ui": ["./packages/web-ui/src/index.ts"],
			"@draht/web-ui/*": ["./packages/web-ui/src/*"],
			"@draht/agent-old": ["./packages/agent-old/src/index.ts"],
			"@draht/agent-old/*": ["./packages/agent-old/src/*"],
			"@draht/geist": ["./packages/geist/src/index.ts"],
			"@draht/geist-core": ["./packages/geist-core/src/index.ts"],
			"@draht/geist-core/*": ["./packages/geist-core/src/*"],
			"@draht/geist-acp": ["./packages/geist-acp/src/index.ts"],
			"@draht/geist-acp/*": ["./packages/geist-acp/src/*"],
			"@draht/geist-protocol": ["./packages/geist-protocol/src/index.ts"],
			"@draht/geist-protocol/*": ["./packages/geist-protocol/src/*"],
			"@draht/geist-picker": ["./packages/geist-picker/src/index.ts"],
			"@draht/geist-console": ["./packages/geist-console/src/index.ts"],
			"@draht/draht-acp": ["./packages/draht-acp/src/index.ts"],
			"@draht/x-markdown": ["./packages/x-markdown/src/index.ts"],
			"@draht/x-markdown/*": ["./packages/x-markdown/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/eval/**/*.ts", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*", "packages/infra/sst-env.d.ts"],
	"exclude": [
		"packages/web-ui/**/*",
		"packages/coding-agent/examples/**/*",
		"**/dist/**",
		"packages/router/test/**/*",
		"packages/invoice/test/**/*",
		"packages/compliance/test/**/*",
		"packages/geist-protocol/test/**/*",
		"packages/geist-core/test/**/*",
		"packages/geist-acp/test/**/*",
		"packages/draht-acp/test/**/*",
		"packages/geist-picker/test/**/*",
		"packages/geist/**/*",
		"packages/geist-console/**/*",
		"packages/reels/**/*",
		"packages/gateway/**/*",
		"packages/landing/**/*"
	]
}
